#  PHYSICS MODEL (17-parameter)
# ════════════════════════════════════════════════════════════════════
def polarization_model(E, p, i_cap=None):
    E = np.asarray(E, dtype=float)
    Ecorr, icorr, ba, bc1, iL = p[0], p[1], p[2], p[3], p[4]
    i0_c2, bc2 = p[5], p[6]
    Epp, k_pass, ipass = p[7], p[8], p[9]
    Eb, a_tp, b_tp = p[10], p[11], p[12]
    Esp, k_sp, ipass2 = p[13], p[14], p[15]
    Rs = max(p[16], 0.0)
    ic = np.zeros_like(E) if i_cap is None else np.asarray(i_cap, dtype=float)

    E_eff = E.copy()
    for _ in range(6 if Rs > 0 else 1):
        eta = E_eff - Ecorr
        ic1k = icorr * np.exp(np.clip(-2.303 * eta / max(bc1, 1e-12), -50, 50))
        i_c1 = ic1k / (1.0 + ic1k / max(iL, 1e-20))
        i_c2 = i0_c2 * np.exp(np.clip(-2.303 * eta / max(bc2, 1e-12), -50, 50))
        i_act = icorr * np.exp(np.clip(2.303 * eta / max(ba, 1e-12), -50, 50))
        t1 = sig(E_eff - Epp, k_pass)
        i_p1 = i_act * (1 - t1) + ipass * t1
        i_tp = a_tp * np.exp(np.clip(b_tp * (E_eff - Eb), -50, 50)) * sig(E_eff - Eb, 40)
        t2 = sig(E_eff - Esp, k_sp)
        i_an = (i_p1 + i_tp) * (1 - t2) + ipass2 * t2
        i_net = i_an - (i_c1 + i_c2) + ic
        if Rs > 0:
            E_eff = E - i_net * Rs
    return i_net


def model_components(E, p):
    E = np.asarray(E, dtype=float)
    Ecorr, icorr, ba, bc1, iL = p[0:5]
    i0_c2, bc2 = p[5:7]
    Epp, k_pass, ipass = p[7:10]
    Eb, a_tp, b_tp = p[10:13]
    Esp, k_sp, ipass2 = p[13:16]
    Rs = max(p[16], 0.0)

    E_eff = E.copy()
    for _ in range(6 if Rs > 0 else 1):
        eta = E_eff - Ecorr
        ic1k = icorr * np.exp(np.clip(-2.303 * eta / max(bc1, 1e-12), -50, 50))
        i_c1 = ic1k / (1 + ic1k / max(iL, 1e-20))
        i_c2 = i0_c2 * np.exp(np.clip(-2.303 * eta / max(bc2, 1e-12), -50, 50))
        i_act = icorr * np.exp(np.clip(2.303 * eta / max(ba, 1e-12), -50, 50))
        t1 = sig(E_eff - Epp, k_pass)
        i_p1 = i_act * (1 - t1) + ipass * t1
        i_tp = a_tp * np.exp(np.clip(b_tp * (E_eff - Eb), -50, 50)) * sig(E_eff - Eb, 40)
        t2 = sig(E_eff - Esp, k_sp)
        i_an = (i_p1 + i_tp) * (1 - t2) + ipass2 * t2
        i_net = i_an - (i_c1 + i_c2)
        if Rs > 0:
            E_eff = E - i_net * Rs
    return dict(ic1=i_c1, ic2=i_c2, iact=i_act, ip1=i_p1, itp=i_tp,
                ian=i_an, t1=t1, t2=t2, itot=i_net)


# ════════════════════════════════════════════════════════════════════
#  ML: SYNTHETIC DATA + CLASSIFIER + SURROGATE
# ════════════════════════════════════════════════════════════════════
def _random_params(ct, rng):
    passive_types = [CT.PASSIVE, CT.PASSIVE_D, CT.PASS_TP, CT.PASS_TP_SP, CT.FULL]
    tp_types = [CT.PASS_TP, CT.PASS_TP_SP, CT.FULL]
    dual_cat = [CT.ACTIVE_H2, CT.PASSIVE_D, CT.PASS_TP, CT.PASS_TP_SP, CT.FULL]
    diff_types = [CT.ACTIVE_D, CT.ACTIVE_H2, CT.PASSIVE_D, CT.PASS_TP, CT.PASS_TP_SP, CT.FULL]
    sp_types = [CT.PASS_TP_SP, CT.FULL]

    Ecorr = rng.uniform(-1.2, 0.2)
    icorr = 10**rng.uniform(-8, -3)
    ba = rng.uniform(0.030, 0.300)
    bc1 = rng.uniform(0.040, 0.400)
    iL = 10**rng.uniform(-6, -2) if ct in diff_types else 1e10
    i0_c2 = 10**rng.uniform(-10, -5) if ct in dual_cat else 1e-30
    bc2 = rng.uniform(0.080, 0.250) if ct in dual_cat else 0.150
    Epp = Ecorr + rng.uniform(0.10, 0.50) if ct in passive_types else Ecorr + 50
    k_pass = rng.uniform(20, 120) if ct in passive_types else 50
    ipass = icorr * 10**rng.uniform(-3, -0.5) if ct in passive_types else icorr
    Eb = Epp + rng.uniform(0.15, 0.60) if ct in tp_types else Epp + 50
    a_tp = ipass * rng.uniform(0.001, 0.1) if ct in tp_types else 1e-30
    b_tp = rng.uniform(3, 25) if ct in tp_types else 8
    Esp = Eb + rng.uniform(0.10, 0.40) if ct in sp_types else Eb + 50
    k_sp = rng.uniform(20, 120) if ct in sp_types else 50
    ipass2 = ipass * rng.uniform(0.3, 3.0) if ct in sp_types else icorr
    Rs = 0.0
    return np.array([Ecorr, icorr, ba, bc1, iL, i0_c2, bc2,
                     Epp, k_pass, ipass, Eb, a_tp, b_tp,
                     Esp, k_sp, ipass2, Rs])


def _extract_features(E, i, n_feat=60):
    si = np.argsort(E)
    E_s, i_s = E[si], i[si]
    ai = np.abs(i_s)
    lg = slog(i_s)
    feats = []

    # Normalized log|i| on fixed grid (20)
    E_norm = np.linspace(0, 1, 20)
    E_01 = (E_s - E_s[0]) / max(E_s[-1] - E_s[0], 1e-6)
    lg_interp = np.interp(E_norm, E_01, lg)
    lg_interp -= lg_interp.mean()
    feats.extend(lg_interp.tolist())

    # Gradient (10)
    dlg = np.gradient(lg_interp, E_norm)
    feats.extend(dlg[::2].tolist())

    # Second derivative (10)
    d2lg = np.gradient(dlg, E_norm)
    feats.extend(d2lg[::2].tolist())

    # Statistics
    feats.append(float(np.std(lg)))
    feats.append(float(np.max(lg) - np.min(lg)))
    feats.append(float(np.median(lg)))

    # Zero crossings
    signs = np.sign(i_s)
    feats.append(float(np.sum(np.abs(np.diff(signs)) > 0)))

    # Cathodic slope
    Ecorr_est = E_s[np.argmin(ai)]
    cat = E_s < Ecorr_est
    if np.sum(cat) > 5:
        try:
            s, _, r, *_ = linregress(E_s[cat][-min(20, np.sum(cat)):],
                                     lg[cat][-min(20, np.sum(cat)):])
            feats.extend([float(s), float(r**2)])
        except:
            feats.extend([0.0, 0.0])
    else:
        feats.extend([0.0, 0.0])

    # Anodic plateau
    an = E_s > Ecorr_est
    if np.sum(an) > 5:
        lg_an = lg[an]
        dlg_an = np.abs(np.gradient(lg_an))
        feats.append(float(np.median(dlg_an)))
        feats.append(float(np.percentile(dlg_an, 90)))
        feats.append(float(np.mean(dlg_an < 0.5)))
    else:
        feats.extend([0.0, 0.0, 0.0])

    # Anodic peaks
    if np.sum(an) > 15:
        lg_sm = sm(lg[an], min(11, (np.sum(an)//2)*2-1 or 5))
        try:
            pks = argrelextrema(lg_sm, np.greater, order=max(3, np.sum(an)//15))[0]
            feats.append(float(len(pks)))
        except:
            feats.append(0.0)
    else:
        feats.append(0.0)

    # Asymmetry
    near_cat = (E_s > Ecorr_est - 0.15) & (E_s < Ecorr_est - 0.02)
    near_an = (E_s > Ecorr_est + 0.02) & (E_s < Ecorr_est + 0.15)
    if np.sum(near_cat) > 3 and np.sum(near_an) > 3:
        try:
            sc, *_ = linregress(E_s[near_cat], lg[near_cat])
            sa, *_ = linregress(E_s[near_an], lg[near_an])
            feats.extend([float(sa - sc), float(abs(sa) / max(abs(sc), 0.1))])
        except:
            feats.extend([0.0, 1.0])
    else:
        feats.extend([0.0, 1.0])

    feats = feats[:n_feat]
    while len(feats) < n_feat:
        feats.append(0.0)
    return np.array(feats, dtype=float)


@st.cache_resource(show_spinner="Training ML classifier on synthetic data...")
def build_classifier(n_samples=300, seed=42):
    rng = np.random.RandomState(seed)
    X_all, y_all = [], []
    types = [CT.ACTIVE, CT.ACTIVE_D, CT.ACTIVE_H2,
             CT.PASSIVE, CT.PASSIVE_D, CT.PASS_TP, CT.FULL]
    for ct in types:
        generated = 0
        attempts = 0
        while generated < n_samples and attempts < n_samples * 5:
            attempts += 1
            try:
                p = _random_params(ct, rng)
                E = np.linspace(p[0] - 0.8, p[0] + 0.8, 200)
                i = polarization_model(E, p)
                if not np.all(np.isfinite(i)) or np.all(np.abs(i) < 1e-30):
                    continue
                noise = 10**rng.uniform(-2.5, -1.0)
                i_n = i * (1 + noise * rng.randn(len(i)))
                if not np.all(np.isfinite(i_n)):
                    continue
                feats = _extract_features(E, i_n)
                if np.all(np.isfinite(feats)):
                    X_all.append(feats)
                    y_all.append(ct)
                    generated += 1
            except:
                continue
    X, y = np.array(X_all), np.array(y_all)
    scaler = StandardScaler()
    X_s = scaler.fit_transform(X)
    clf = RandomForestClassifier(n_estimators=200, max_depth=15,
        min_samples_leaf=5, random_state=seed, n_jobs=-1, class_weight='balanced')
    clf.fit(X_s, y)
    return clf, scaler


@st.cache_resource(show_spinner="Training neural surrogate...")
def build_surrogate(n_samples=300, seed=42):
    rng = np.random.RandomState(seed)
    X_all, y_all = [], []
    p_lo = np.array([-1.5, -10, 0.01, 0.01, -8, -12, 0.04,
                     -1.5, 5, -10, -1.0, -30, 0.5, -0.5, 5, -10, 0])
    p_hi = np.array([0.5, -2, 0.5, 0.5, -1, -4, 0.35,
                     1.0, 200, -3, 1.5, -10, 40, 2.0, 200, -3, 0])
    for ct in [CT.ACTIVE_D, CT.ACTIVE_H2, CT.PASSIVE_D, CT.PASS_TP, CT.FULL]:
        generated = 0
        attempts = 0
        while generated < n_samples and attempts < n_samples * 5:
            attempts += 1
            try:
                p = _random_params(ct, rng)
                E = np.linspace(p[0] - 0.8, p[0] + 0.8, 200)
                i = polarization_model(E, p)
                if not np.all(np.isfinite(i)) or np.all(np.abs(i) < 1e-30):
                    continue
                noise = 10**rng.uniform(-2.5, -1.0)
                i_n = i * (1 + noise * rng.randn(len(i)))
                if not np.all(np.isfinite(i_n)):
                    continue
                feats = _extract_features(E, i_n)
                p_norm = np.zeros(NP)
                for j in range(NP):
                    val = np.log10(max(p[j], 1e-30)) if j in LOG_PARAMS else p[j]
                    p_norm[j] = np.clip((val - p_lo[j]) / max(p_hi[j] - p_lo[j], 1e-6), 0, 1)
                if np.all(np.isfinite(feats)) and np.all(np.isfinite(p_norm)):
                    X_all.append(feats)
                    y_all.append(p_norm)
                    generated += 1
            except:
                continue
    X, Y = np.array(X_all), np.array(y_all)
    scaler = StandardScaler()
    X_s = scaler.fit_transform(X)
    net = MLPRegressor(hidden_layer_sizes=(128, 64, 32), activation='relu',
        solver='adam', max_iter=500, random_state=seed, early_stopping=True,
        validation_fraction=0.15, learning_rate='adaptive', alpha=0.001)
    net.fit(X_s, Y)
    return net, scaler, p_lo, p_hi


# ════════════════════════════════════════════════════════════════════
#  ECORR DETECTION
# ════════════════════════════════════════════════════════════════════
def detect_ecorr(E, i):
    n = len(E)
    if n == 0:
        return 0.0, 0
    si = np.argsort(E)
    Es, Is = E[si], i[si]
    max_w = max(5, (n // 5) | 1)
    w = min(max_w, 11)
    if w % 2 == 0: w -= 1
    w = max(5, w)
    try:
        ism = savgol_filter(Is, w, min(3, w-1)) if n >= w >= 5 else Is.copy()
    except:
        ism = Is.copy()

    def find_cx(ia):
        cands = []
        for k in range(len(ia) - 1):
            if np.sign(ia[k]) * np.sign(ia[k+1]) < 0:
                d = ia[k+1] - ia[k]
                if abs(d) < 1e-30: continue
                Ec = Es[k] - ia[k] * (Es[k+1] - Es[k]) / d
                cands.append(dict(Ec=Ec, k=int(si[k]), anodic=(ia[k] < 0 and ia[k+1] > 0)))
        return cands

    cands = find_cx(Is) + [c for c in find_cx(ism)
                           if round(c["Ec"], 4) not in set(round(c2["Ec"], 4) for c2 in find_cx(Is))]
    if not cands:
        k = int(np.argmin(np.abs(Is)))
        return float(Es[k]), int(si[k])
    anodic = [c for c in cands if c["anodic"]]
    best = min(anodic, key=lambda c: c["Ec"]) if anodic else min(cands, key=lambda c: c["Ec"])
    return best["Ec"], best["k"]


# ════════════════════════════════════════════════════════════════════
#  SEPARATE PRE-FITTING
# ════════════════════════════════════════════════════════════════════
def fit_cathodic(E, i, Ecorr):
    cat = (E < Ecorr - 0.02)
    if np.sum(cat) < 5:
        return 0.120, 1e-6, None, False
    Ec, ic, lg = E[cat], np.abs(i[cat]), slog(np.abs(i[cat]))
    si = np.argsort(Ec); Ec, ic, lg = Ec[si], ic[si], lg[si]

    best_r2, best_s, best_b = 0, -8.0, -6.0
    mp = max(5, len(Ec) // 5)
    for s0 in range(max(1, len(Ec) - mp)):
        for s1 in range(s0 + mp, min(s0 + 50, len(Ec))):
            try:
                sl, b, r, *_ = linregress(Ec[s0:s1], lg[s0:s1])
                if sl < -1.0 and r**2 > best_r2 and 0.02 < abs(1/sl) < 0.6:
                    best_r2, best_s, best_b = r**2, sl, b
            except: continue

    bc = abs(1/best_s) if abs(best_s) > 0.1 else 0.120
    icorr_cat = 10**(best_b + best_s * Ecorr)

    # Diffusion plateau
    iL = None
    if len(Ec) > 15:
        lg_sm = sm(lg, min(11, (len(Ec)//2)*2-1 or 5))
        dlg = np.abs(np.gradient(lg_sm, Ec))
        flat = dlg < max(np.percentile(dlg, 30), 0.7)
        runs = [(k, list(g)) for k, g in groupby(enumerate(flat), key=lambda x: x[1]) if k]
        if runs:
            best_run = max(runs, key=lambda x: len(x[1]))
            idxs = [s[0] for s in best_run[1]]
            if len(idxs) >= 3 and abs(Ec[idxs[-1]] - Ec[idxs[0]]) > 0.02:
                iL = float(np.median(ic[idxs]))

    # H₂ evolution
    has_H2 = False
    if iL and len(Ec) > 20:
        half = len(Ec) // 2
        try:
            s1, _, r1, *_ = linregress(Ec[:half], lg[:half])
            s2, _, r2, *_ = linregress(Ec[half:], lg[half:])
            if r1**2 > 0.8 and r2**2 > 0.8 and abs(s1 - s2) > 2:
                has_H2 = True
        except: pass

    return bc, max(icorr_cat, 1e-15), iL, has_H2


def fit_anodic(E, i, Ecorr):
    an = (E > Ecorr + 0.02)
    if np.sum(an) < 5:
        return 0.060, {}
    Ea, ia, lg = E[an], np.abs(i[an]), slog(np.abs(i[an]))
    si = np.argsort(Ea); Ea, ia, lg = Ea[si], ia[si], lg[si]

    best_r2, best_s = 0, 8.0
    mp = max(5, len(Ea) // 5)
    for s0 in range(max(1, len(Ea) - mp)):
        for s1 in range(s0 + mp, min(s0 + 50, len(Ea))):
            try:
                sl, b, r, *_ = linregress(Ea[s0:s1], lg[s0:s1])
                if sl > 1.0 and r**2 > best_r2 and 0.02 < abs(1/sl) < 0.6:
                    best_r2, best_s = r**2, sl
            except: continue

    ba = abs(1/best_s) if abs(best_s) > 0.1 else 0.060
    info = {"has_passive": False, "has_transpassive": False}

    if len(Ea) > 15:
        lg_sm = sm(lg, min(15, (len(Ea)//2)*2-1 or 5))
        adl = np.abs(np.gradient(lg_sm, Ea))
        thr = max(np.percentile(adl, 25), 0.8)
        flat = adl < thr
        runs = [(k, list(g)) for k, g in groupby(enumerate(flat), key=lambda x: x[1]) if k]
        for _, ri in runs:
            idxs = [s[0] for s in ri]
            rng = abs(Ea[idxs[-1]] - Ea[idxs[0]])
            if len(idxs) >= 5 and rng > 0.08:
                im = float(np.median(ia[idxs]))
                pre = Ea < Ea[idxs[0]]
                if np.sum(pre) > 2 and im < np.max(ia[pre]) * 0.4:
                    info["has_passive"] = True
                    info["Epp"] = float(Ea[idxs[0]])
                    info["ipass"] = im
                    # Transpassive
                    post = Ea > Ea[idxs[-1]]
                    if np.sum(post) > 5:
                        dlg_post = np.gradient(lg[np.where(post)[0]], Ea[post])
                        if np.max(dlg_post) > 3.0:
                            info["has_transpassive"] = True
                            info["Eb"] = float(Ea[post][np.argmax(dlg_post > 3.0)])
                    break
    return ba, info


# ════════════════════════════════════════════════════════════════════
#  INITIAL GUESS BUILDER
# ════════════════════════════════════════════════════════════════════
def build_p0(E, i, Ecorr, bc, ba, icorr_c, iL, has_H2, an_info, ct):
    Emax = float(np.max(E))
    ic = max(icorr_c, 1e-12)
    ai = np.abs(i)

    Epp_est = an_info.get("Epp", Ecorr + 0.25)
    ipass_est = an_info.get("ipass", ic * 0.1)
    Eb_est = an_info.get("Eb", Epp_est + 0.30)

    if not an_info.get("has_passive") and ct in CT.PASSIVE_TYPES:
        an_mask = E > Ecorr + 0.05
        if np.sum(an_mask) > 10:
            lg_an = slog(ai[an_mask])
            E_an = E[an_mask]
            lg_sm = sm(lg_an, min(11, (np.sum(an_mask)//2)*2-1 or 5))
            mi = np.argmin(lg_sm)
            if 2 < mi < len(lg_sm) - 2:
                Epp_est = float(E_an[max(0, mi - 3)])
                ipass_est = float(10**lg_sm[mi])

    iL_val = iL if iL is not None else max(np.percentile(ai, 95), ic * 100)

    return np.array([
        Ecorr, ic, max(ba, 0.020), max(bc, 0.020), iL_val,
        ic * 1e-3 if has_H2 else 1e-30, 0.150,
        Epp_est if ct in CT.PASSIVE_TYPES else Emax + 10,
        40.0 if ct in CT.PASSIVE_TYPES else 50.0,
        ipass_est if ct in CT.PASSIVE_TYPES else ic,
        Eb_est if ct in [CT.PASS_TP, CT.PASS_TP_SP, CT.FULL] else Emax + 10,
        ipass_est * 0.01 if ct in [CT.PASS_TP, CT.PASS_TP_SP, CT.FULL] else 1e-30,
        8.0, Emax + 20, 50.0, ic, 0.0
    ])


# ════════════════════════════════════════════════════════════════════
#  OPTIMIZER
# ════════════════════════════════════════════════════════════════════
def optimize_model(E, i, ct, p0, reg, fit_rs=False, rs_max=200.0, progress_cb=None):
    """Fit a single model. Returns (params, r2, aicc_val)."""
    ld = slog(i)
    n = len(E)
    fidx = CT.free_idx(ct) + ([16] if fit_rs else [])
    nf = len(fidx)

    Ec = p0[0]
    ic = max(p0[1], 1e-14)
    Emax, Emin = float(np.max(E)), float(np.min(E))

    # Bounds
    lo = np.array([
        Emin, max(ic*1e-5,1e-15), 0.01, 0.01, max(ic*0.1,1e-10), max(ic*1e-8,1e-18), 0.04,
        Ec-0.05 if reg.get("has_passive") else Emax+5, 5.0,
        max(ic*1e-5,1e-15) if reg.get("has_passive") else 1e-15,
        Ec if reg.get("has_transpassive") else Emax+5, 1e-30, 0.5,
        Ec if reg.get("has_sp") else Emax+10, 5.0, max(ic*1e-5,1e-15), 0.0
    ])
    hi = np.array([
        Emax, min(ic*1e5,1e1), 0.5, 0.5, max(ic*1e6,1e0), max(ic*100,1e-4), 0.4,
        Emax if reg.get("has_passive") else Emax+15, 200.0,
        max(ic*1e3,1e-2) if reg.get("has_passive") else 1e-2,
        Emax+0.2 if reg.get("has_transpassive") else Emax+15, max(ic*1e4,1e-6), 40.0,
        Emax+0.5 if reg.get("has_sp") else Emax+25, 200.0, max(ic*1e3,1e-2), rs_max
    ])
    for j in range(NP):
        if lo[j] >= hi[j]:
            m = p0[j]; lo[j] = m - abs(m)*0.5 - 1e-6; hi[j] = m + abs(m)*0.5 + 1e-6

    def pack(pf):
        return np.array([np.log10(max(pf[j],1e-30)) if j in LOG_PARAMS else pf[j] for j in fidx])
    def unpack(x):
        p = p0.copy()
        for k, j in enumerate(fidx): p[j] = 10**x[k] if j in LOG_PARAMS else x[k]
        return p
    def pbounds():
        return [(np.log10(max(lo[j],1e-30)), np.log10(max(hi[j],1e-30)))
                if j in LOG_PARAMS else (lo[j], hi[j]) for j in fidx]
    def obj(x):
        p = unpack(x)
        if p[1] < 1e-14 or p[1] > 0.1: return 1e30
        try:
            pred = polarization_model(E, p)
            return float(np.sum((ld - slog(pred))**2))
        except: return 1e30

    best_p, best_sse = p0.copy(), obj(pack(p0))
    bnds = pbounds()

    def up(x):
        nonlocal best_p, best_sse
        s = obj(x)
        if s < best_sse: best_p, best_sse = unpack(x), s; return True
        return False

    # DE
    try:
        ps = max(12, min(20, nf*2)); mi = max(250, min(800, nf*40))
        res = differential_evolution(obj, bnds, seed=42, maxiter=mi, popsize=ps,
            tol=1e-14, mutation=(0.5,1.9), recombination=0.9, polish=False, workers=1)
        up(res.x)
        if progress_cb: progress_cb(0.5)
    except: pass

    # L-BFGS-B
    try:
        r2 = minimize(obj, pack(best_p), method="L-BFGS-B", bounds=bnds,
            options={"maxiter": 25000, "ftol": 1e-16})
        up(r2.x)
        if progress_cb: progress_cb(0.7)
    except: pass

    # Nelder-Mead
    try:
        r3 = minimize(obj, pack(best_p), method="Nelder-Mead",
            options={"maxiter": 15000, "xatol": 1e-14, "fatol": 1e-16, "adaptive": True})
        up(r3.x)
        if progress_cb: progress_cb(0.85)
    except: pass

    # Powell
    try:
        r4 = minimize(obj, pack(best_p), method="Powell",
            options={"maxiter": 10000, "xtol": 1e-14, "ftol": 1e-16})
        up(r4.x)
        if progress_cb: progress_cb(1.0)
    except: pass

    pred = polarization_model(E, best_p)
    r2_val = r2sc(ld, slog(pred))
    sse = np.sum((ld - slog(pred))**2)
    aicc_val = aicc(n, nf, sse)

    return best_p, r2_val, aicc_val


