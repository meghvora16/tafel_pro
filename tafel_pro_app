                ct_candidates.append(CT.ACTIVE_D)

            status.update(label="✅ Stage 1 complete", state="complete")

        # ── Stage 2: Pre-Fitting ──
        with st.status("🔧 Stage 2: Separate Pre-Fitting + Neural Surrogate...", expanded=True) as status:
            bc, icorr_c, iL, has_H2 = fit_cathodic(E, i, Ecorr)
            ba, an_info = fit_anodic(E, i, Ecorr)

            c1, c2 = st.columns(2)
            with c1:
                st.markdown("**Cathodic pre-fit:**")
                st.write(f"bc = {bc:.4f} V/dec | icorr = {icorr_c:.2e} A/cm²")
                st.write(f"iL = {'%.2e'%iL if iL else 'N/A'} | H₂ = {has_H2}")
            with c2:
                st.markdown("**Anodic pre-fit:**")
                st.write(f"ba = {ba:.4f} V/dec")
                st.write(f"Passive: {an_info.get('has_passive', False)} | "
                         f"Transpassive: {an_info.get('has_transpassive', False)}")

            # Neural surrogate
            surr_feats = surr_scaler.transform(feats.reshape(1, -1))
            p_norm = surr.predict(surr_feats)[0]
            p_surr = np.zeros(NP)
            for j in range(NP):
                val = surr_lo[j] + p_norm[j] * (surr_hi[j] - surr_lo[j])
                p_surr[j] = 10**val if j in LOG_PARAMS else val

            reg = {"Ecorr": Ecorr, "iL": iL, "has_H2": has_H2,
                   "has_passive": an_info.get("has_passive", False),
                   "has_transpassive": an_info.get("has_transpassive", False),
                   "has_sp": False}

            status.update(label="✅ Stage 2 complete", state="complete")

        # ── Stage 3: Optimization ──
        with st.status("⚡ Stage 3: Optimization & Model Selection...", expanded=True) as status:
            all_results = []
            progress = st.progress(0.0)

            for idx, ct_try in enumerate(ct_candidates):
                ct_name = CT.name(ct_try)
                st.write(f"Fitting **{ct_name}** ({CT.nfree(ct_try)} free params)...")

                p0 = build_p0(E, i, Ecorr, bc, ba, icorr_c, iL, has_H2, an_info, ct_try)

                # Blend with surrogate for params physics didn't detect
                if not an_info.get("has_passive") and ct_try in CT.PASSIVE_TYPES:
                    for j in [7, 8, 9]: p0[j] = p_surr[j]
                if not an_info.get("has_transpassive") and ct_try in [CT.PASS_TP, CT.PASS_TP_SP, CT.FULL]:
                    for j in [10, 11, 12]: p0[j] = p_surr[j]

                def prog_cb(frac, _idx=idx, _n=len(ct_candidates)):
                    progress.progress((_idx + frac) / _n)

                bp_try, r2_try, aic_try = optimize_model(
                    E, i, ct_try, p0, reg, fit_rs, rs_max, prog_cb)

                all_results.append(dict(ct=ct_try, name=ct_name,
                    nfree=CT.nfree(ct_try), r2=r2_try, aicc=aic_try, params=bp_try))

                st.write(f"  → R² = {r2_try:.6f} | AICc = {aic_try:.0f}")

            progress.progress(1.0)

            # Select best by AICc
            all_results.sort(key=lambda x: x["aicc"])
            best = all_results[0]
            # Parsimony override
            for r in all_results:
                if r["nfree"] < best["nfree"] and best["r2"] - r["r2"] < 0.002:
                    best = r
                    break

            bp = best["params"]
            r2 = best["r2"]
            best_ct = best["ct"]

            status.update(label="✅ Stage 3 complete", state="complete")

        # ══════════════════════════════════════════════════════════
        # RESULTS
        # ══════════════════════════════════════════════════════════
        st.markdown("---")
        st.header("📊 Results")

        # Quality stars
        stars = "★★★★★" if r2 >= 0.995 else "★★★★☆" if r2 >= 0.99 else \
                "★★★☆☆" if r2 >= 0.98 else "★★☆☆☆" if r2 >= 0.95 else "★☆☆☆☆"
        quality = "EXCEPTIONAL" if r2 >= 0.995 else "EXCELLENT" if r2 >= 0.99 else \
                  "VERY GOOD" if r2 >= 0.98 else "GOOD" if r2 >= 0.95 else "ACCEPTABLE"

        st.markdown(f'<div class="star-rating">{stars} {quality}</div>',
                    unsafe_allow_html=True)

        # Key metrics
        ew, rho = MATERIALS[material]
        B = (bp[2]*bp[3]) / (2.303*(bp[2]+bp[3])) if bp[2] > 0 and bp[3] > 0 else 0
        CR = bp[1] * 3.27 * ew / rho

        c1, c2, c3, c4, c5 = st.columns(5)
        c1.metric("E_corr", f"{bp[0]:.4f} V")
        c2.metric("i_corr", f"{bp[1]:.2e} A/cm²")
        c3.metric("R² (log)", f"{r2:.6f}")
        c4.metric("CR", f"{CR:.4f} mm/yr")
        c5.metric("Model", CT.name(best_ct))

        c1, c2, c3, c4 = st.columns(4)
        c1.metric("ba", f"{bp[2]:.4f} V/dec")
        c2.metric("bc", f"{bp[3]:.4f} V/dec")
        c3.metric("B (Stern-Geary)", f"{B:.4f} V")
        if best_ct not in [CT.ACTIVE]:
            c4.metric("i_L", f"{bp[4]:.2e} A/cm²")

        if best_ct in CT.PASSIVE_TYPES:
            c1, c2 = st.columns(2)
            c1.metric("E_pp", f"{bp[7]:.4f} V")
            c2.metric("i_pass", f"{bp[9]:.2e} A/cm²")

        # Main plot
        st.plotly_chart(make_main_plot(E, i, bp, Ecorr, r2, best_ct),
                        use_container_width=True)

        # Residuals
        with st.expander("📈 Residual Plot"):
            st.plotly_chart(make_residual_plot(E, i, bp), use_container_width=True)

        # Model comparison table
        with st.expander("🏆 Model Comparison (AICc)"):
            comp_data = []
            for r in all_results:
                sel = "✅" if r["ct"] == best_ct else ""
                comp_data.append({
                    "Model": r["name"], "N_free": r["nfree"],
                    "R²": f"{r['r2']:.6f}", "AICc": f"{r['aicc']:.0f}",
                    "Selected": sel
                })
            st.dataframe(pd.DataFrame(comp_data), use_container_width=True, hide_index=True)

        # All 17 parameters
        with st.expander("🔧 Full Parameter Table"):
            param_data = []
            for j, name in enumerate(PARAM_NAMES):
                active = j in CT.free_idx(best_ct) or (j == 16 and fit_rs)
                param_data.append({
                    "Parameter": name,
                    "Value": f"{bp[j]:.6e}" if j in LOG_PARAMS else f"{bp[j]:.6f}",
                    "Active": "✅" if active else "—",
                    "Description": ["Corrosion potential", "Corrosion current density",
                        "Anodic Tafel slope", "Cathodic Tafel slope (O₂)",
                        "O₂ diffusion limiting current", "H₂ exchange current",
                        "Cathodic Tafel slope (H₂)", "Passivation onset potential",
                        "Passivation transition sharpness", "Passive current density",
                        "Breakdown potential", "Transpassive pre-exponential",
                        "Transpassive exponential factor", "Secondary passivity onset",
                        "Secondary passivity sharpness", "Secondary passive current",
                        "Solution resistance"][j]
                })
            st.dataframe(pd.DataFrame(param_data), use_container_width=True, hide_index=True)

        # Downloads
        st.markdown("---")
        st.subheader("💾 Downloads")
        c1, c2, c3 = st.columns(3)

        with c1:
            csv_str = results_csv(bp, r2, best_ct, Ecorr, ew, rho, all_results, fit_rs)
            st.download_button("📄 Results CSV", csv_str,
                file_name="tafel_results.csv", mime="text/csv")

        with c2:
            Z_fit = polarization_model(E, bp)
            fit_df = pd.DataFrame({
                "E_V": E, "i_measured": i, "log_i_meas": slog(i),
                "i_fit": Z_fit, "log_i_fit": slog(Z_fit),
                "residual": slog(i) - slog(Z_fit)
            })
            st.download_button("📄 Fit Data CSV", fit_df.to_csv(index=False),
                file_name="tafel_fitdata.csv", mime="text/csv")

        with c3:
            comp_df = pd.DataFrame([{
                "Model": r["name"], "N_free": r["nfree"],
                "R2": r["r2"], "AICc": r["aicc"]
            } for r in all_results])
            st.download_button("📄 Model Comparison", comp_df.to_csv(index=False),
                file_name="tafel_models.csv", mime="text/csv")

        # Store results in session state for potential re-use
        st.session_state["last_results"] = dict(
            bp=bp, r2=r2, best_ct=best_ct, Ecorr=Ecorr,
            all_results=all_results, E=E, i=i
        )


if __name__ == "__main__":
    main()
